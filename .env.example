# Copy to .env and fill in. Never commit .env.

# The address people use to reach Sprig. For local testing keep http://localhost:8080.
PUBLIC_URL=http://localhost:8080

# Who may sign in (comma-separated). The owner must also be listed.
ALLOWED_EMAILS=you@example.com
OWNER_EMAIL=you@example.com

# Sign-in providers. Each one is on when both its values are set. Redirect URIs to register:
#   Google    <PUBLIC_URL>/auth/google/callback     (Google Cloud console > Credentials > OAuth client ID)
#   Facebook  <PUBLIC_URL>/auth/facebook/callback   (developers.facebook.com > your app > Facebook Login)
#   X         <PUBLIC_URL>/auth/x/callback          (developer.x.com > your app > User authentication settings)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
X_CLIENT_ID=
X_CLIENT_SECRET=
# FACEBOOK_GRAPH_VERSION=v26.0

# Local test sign-in without Google. Only allowed when PUBLIC_URL is localhost. Never on a server.
DEV_LOGIN=1

# Generate each with: openssl rand -hex 32
SESSION_SECRET=
SHARE_KEY=
